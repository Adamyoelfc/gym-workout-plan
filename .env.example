# Copy to .env and fill in. Used by docker-compose.

# --- Database (Postgres container) ---
POSTGRES_USER=shred
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=shred

# --- Auth ---
# Generate a strong secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

# --- AI (OpenRouter) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Use an OpenRouter model that supports function/tool calling.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Hard server-side cost controls. Set tighter values for a private deployment.
AI_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=100
AI_GLOBAL_DAILY_USD=5
AI_MAX_OUTPUT_TOKENS=1600
# Maximum tool-call turns per coach response (hard-capped at 8).
AI_MAX_TOOL_ROUNDS=4
# Fallback when the browser cannot provide an IANA time zone.
APP_TIME_ZONE=America/New_York

# Optional key subscribed to "EDB WITH IMAGES AND GIFS by AscendAPI" on RapidAPI.
# If empty, the server attempts to use the public OSS API.
RAPIDAPI_KEY=

# --- Email (verification and password reset) ---
# Resend uses HTTPS and is preferred in production. SMTP remains as a fallback.
# For development, leave both providers empty to log links to the console.
EMAIL_FROM=noreply@gym-app.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- App ---
# Host port the app is exposed on (container always listens on 8080).
APP_PORT=8080
# Public URL of the deployment (used in OpenRouter referer header and email links).
PUBLIC_URL=http://localhost:8080
TRUST_PROXY_HOPS=0
# Cookie scope. Production under a subpath uses /gym-ai-web.
SESSION_COOKIE_PATH=/
# Registro de cuentas: cerrado por defecto (app privada).
# ALLOW_REGISTRATION=true lo abre a cualquiera; ALLOWED_EMAILS=a@b.com,c@d.com solo a esos correos.
ALLOW_REGISTRATION=false
ALLOWED_EMAILS=
